# Nabız Analiz ayarları. .env olarak kopyala; .env GitHub'a GÖNDERİLMEZ.
PORT=8000
# Arıza Defteri (aynı sunucuda iç ağ adresi)
ARIZA_DEFTERI_URL=http://ariza-defteri:8080
# Analiz dönemi (gün, 90-365). Arıza Defteri en az bu kadar geçmiş tutmalı (GECMIS_GUN).
ANALIZ_GUN=360
# Plansız duruş, planlı bakım duruşundan kaç kat pahalı sayılsın (üretim kaybı, acele, yedek parça). 1-10.
PLANSIZ_CARPAN=2
DAKIKALIK_ISTEK=60
# MCP kapısı: bu kurulumda dışarı açık değil; Claude'a Nabız üzerinden ulaşılır. Açmak istersen anahtarla.
MCP_ENABLED=false
MCP_ANAHTARLARI=
